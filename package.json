{
  "name": "fridgelist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Fridge List \u2014 household meal planning and shopping list",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "mutate": "node tools/mutate.js",
    "test:ui": "vitest run --config vitest.ui.config.js",
    "check": "npm test && npm run test:ui",
    "screens": "node tools/screens.js"
  },
  "devDependencies": {
    "fast-check": "^3.23.2",
    "playwright": "^1.56.1",
    "vitest": "^2.1.9"
  }
}
